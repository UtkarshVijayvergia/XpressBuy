#!/usr/bin/env node
// command: ./bin/ddb/seed-data prod

const { DynamoDBClient } = require("@aws-sdk/client-dynamodb");
const { DynamoDBDocumentClient, PutCommand } = require("@aws-sdk/lib-dynamodb");
const fs = require('fs');
const path = require('path');

// Set the endpoint to the local dynamodb
let attrs = {
    endpoint: 'http://localhost:8000'
};

// Check if we are in production mode
console.log("process.argv.length: " + process.argv.length);
if (process.argv.length === 3) {
    if (process.argv[2].includes("prod")) {
        attrs = {
            endpoint: 'https://dynamodb.us-east-1.amazonaws.com'
        };
    }
}

console.log("attrs: " + JSON.stringify(attrs));

// Create a new client
const client = new DynamoDBClient(attrs);
const docClient = DynamoDBDocumentClient.from(client);

// Create a new item
async function batch_write() {
    try {
        const productFiles = [
            'product1.json',
            'product2.json',
            'product3.json',
            'product4.json',
            'product5.json'
        ];

        for (const file of productFiles) {
            let fileData;
            try {
                fileData = await fs.promises.readFile(path.join(__dirname, '../data/products', file), 'utf8');
            } catch (err) {
                console.error(err);
                throw err;
            }
            let items = JSON.parse(fileData);
            for (const item of items) {
                const params = {
                    TableName: 'xpressbuy',
                    Item: item
                };
                await docClient.send(new PutCommand(params));
            }
            console.log(`${file} Added successfully`);
        }

        // Category
        let fileData;
        try {
            fileData = await fs.promises.readFile(path.join(__dirname, '../data/categories/categories.json'), 'utf8');
        } catch (err) {
            console.error(err);
            throw err;
        }
        let items = JSON.parse(fileData);
        for (const item of items) {
            const params = {
                TableName: 'xpressbuy',
                Item: item
            };
            await docClient.send(new PutCommand(params));
        }
        console.log('Categories Added successfully');
    } catch (error) {
        console.error(error);
    }
};

batch_write();